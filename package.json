{
  "name": "cc-profile-switch",
  "version": "0.1.0",
  "description": "Cross-platform CLI for switching Claude Code user-level configuration profiles.",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "bin": {
    "ccps": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "prototype": "esbuild src/tui/prototype-workbench/index.mts --bundle --format=esm --platform=node --packages=external --outfile=node_modules/.cache/ccps-proto-workbench.mjs && node node_modules/.cache/ccps-proto-workbench.mjs",
    "prototype:edit": "esbuild src/tui/prototype-edit-session/index.mts --bundle --format=esm --platform=node --packages=external --outfile=node_modules/.cache/ccps-proto-edit-session.mjs && node node_modules/.cache/ccps-proto-edit-session.mjs",
    "build": "tsup src/index.ts --format cjs --clean && node scripts/copy-templates.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build",
    "codegraph:init": "codegraph init .",
    "codegraph:index": "codegraph index . --force",
    "codegraph:sync": "codegraph sync .",
    "codegraph:status": "codegraph status .",
    "codegraph:query": "codegraph query",
    "codegraph:explore": "codegraph explore"
  },
  "keywords": [
    "claude-code",
    "cli",
    "profiles",
    "windows",
    "macos",
    "linux"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "fs-extra": "^11.3.2",
    "picocolors": "^1.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.0.1",
    "@eslint/js": "^9.39.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.1",
    "ink": "^7.1.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
